# ==============================================================================
# HandVision AI — Environment Configuration Example
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Vision Model Configuration
MAX_HANDS=4
MIN_DETECTION_CONFIDENCE=0.5
MIN_PRESENCE_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# Tracking Parameters
TRACK_MAX_DISAPPEARED=15
TRACK_DISTANCE_THRESHOLD=0.25
TRACK_IOU_THRESHOLD=0.2

# Frame Processing Constraints
MAX_FRAME_WIDTH=640
MAX_FRAME_HEIGHT=480

# Frontend Configuration (used by Vite)
VITE_BACKEND_PORT=8000
# VITE_WS_URL=ws://localhost:8000/ws/detect
